# Copy to web/.env.local if you need different values. These are not secrets (a public SPA client).
# Desktop: the services directly. Phone/anywhere: one public HTTPS hostname in BOTH values — the dev
# server proxies /realms and /api to the services (see vite.config.ts), so no CORS/cookies are needed.
VITE_API_URL=http://localhost:8082
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=gh-staff
VITE_KEYCLOAK_CLIENT_ID=erp-web
