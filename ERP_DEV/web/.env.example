# Web shell config — variable names and FAKE values only. Never commit a real .env.
# Base URL of erp-app. Blank = same origin (vite proxy or same-host deploy).
VITE_API_URL=
# Keycloak public client (wired in 3.x when realm exists; names only until then).
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=resort
VITE_KEYCLOAK_CLIENT_ID=erp-web
