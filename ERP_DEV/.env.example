# Example environment — variable names and FAKE values only. Never commit a real .env.
APP_ENV=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resort_erp
DB_USER=resort_user
DB_PASSWORD=change-me-locally-only
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/resort
JWT_SECRET=golden-hills-resort-dev-jwt-secret-min-32-chars-long
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ERP_APP_URL=http://localhost:8080
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_API_KEY=
# WhatsApp (Meta Cloud API). mock = log only, no Meta account needed. Real values go in your local .env / secret store only.
# lead-service reads ERP_DEV/.env automatically (spring.config.import). Go-live steps: PLAN-3.14 §Slice 1b "Go live with real Meta".
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=new_lead_assigned
WHATSAPP_TEMPLATE_LANGUAGE=en
# lead-service reads sales staff phone_number / whatsapp_on_duty from Keycloak (client "lead-service", view-users only).
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_REALM=resort
LEAD_SERVICE_CLIENT_ID=lead-service
LEAD_SERVICE_CLIENT_SECRET=change-me-dev-only
OTA_API_CREDENTIALS_REF=vault:ota/creds

# Observability / ops console (Phase 1). Leave telemetry URLs blank for honest
# NOT_CONFIGURED states; enable tracing only when a collector endpoint exists.
OPS_ENVIRONMENT=local
OPS_PROMETHEUS_URL=
OPS_LOKI_URL=
OPS_TEMPO_URL=
OPS_GRAFANA_URL=
OPS_INTEGRATION_TIMEOUT_MS=2000
OPS_TELEMETRY_STALE_SECONDS=120
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=erp-app
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
MANAGEMENT_PORT=9091
MANAGEMENT_ADDRESS=127.0.0.1
LOG_FILE=logs/erp-app.jsonl
APP_VERSION=dev
