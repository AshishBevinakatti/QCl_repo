<?xml version="1.0" encoding="UTF-8"?>
<!-- Golden Hills Resort ERP — parent aggregator (modular monolith, ADR-001). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.quantumclk.erp</groupId>
  <artifactId>resort-erp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Golden Hills Resort ERP (parent)</name>

  <modules>
    <module>services/erp-app</module>
    <module>services/lead-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.2.5</spring-boot.version>
  </properties>
